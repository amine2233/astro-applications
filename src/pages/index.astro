---
// Root "/" → /fr/ for French browsers, /en/ otherwise.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`1; url=${base}en/`} />
    <link rel="canonical" href={`${base}en/`} />
    <script is:inline define:vars={{ base }}>
      const lang = (navigator.language || 'en').toLowerCase().startsWith('fr') ? 'fr' : 'en';
      location.replace(`${base}${lang}/`);
    </script>
  </head>
  <body><a href={`${base}en/`}>English</a> · <a href={`${base}fr/`}>Français</a></body>
</html>
